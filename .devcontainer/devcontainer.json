{
  "name": "GeoMap full-stack development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "64gb" },
  "forwardPorts": [8095, 8096, 9011],
  "portsAttributes": {
    "8095": { "label": "GeoMap portal", "onAutoForward": "openBrowser" },
    "8096": { "label": "Airflow" },
    "9011": { "label": "MinIO administration" }
  },
  "postCreateCommand": "bash scripts/start_codespaces.sh",
  "postStartCommand": "docker compose up -d",
  "remoteUser": "vscode"
}
