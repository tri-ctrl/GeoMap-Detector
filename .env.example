# Independent local ports; change these when another application uses them.
COMPOSE_PROJECT_NAME=geomap-detector
WEB_PORT=8095
AIRFLOW_PORT=8096
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
# Must match the MinIO address reachable by the browser. Do not rewrite signed URLs.
S3_PUBLIC_ENDPOINT=http://localhost:9010
UPLOAD_CORS_ORIGIN=http://localhost:8095
S3_ACCESS_KEY=geomap-local
S3_SECRET_KEY=geomap-local-secret
POSTGRES_PASSWORD=geomap-local-db
AIRFLOW_USER=geomap
AIRFLOW_PASSWORD=geomap-local-airflow
AIRFLOW_SECRET_KEY=geomap-local-airflow-secret
# Optional mirror of the same official Airflow base image for restricted networks:
# AIRFLOW_BASE_IMAGE=your-registry/apache/airflow:2.11.1-python3.12
# GO_MODULE_PROXY=direct
MAX_UPLOAD_BYTES=10737418240
