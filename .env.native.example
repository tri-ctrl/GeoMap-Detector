# Native/managed infrastructure endpoints; use dedicated databases and buckets.
DATABASE_URL=postgresql://geomap:replace-with-url-safe-password@127.0.0.1:5545/geomap
S3_ENDPOINT=http://127.0.0.1:9018
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9018
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret
S3_BUCKET=geomap-files
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19095
# Include the portal origin in your S3 service's CORS configuration and expose ETag.
UPLOAD_CORS_ORIGIN=http://localhost:8098,https://tri-ctrl.github.io
AIRFLOW_API_USER=geomap
AIRFLOW_API_PASSWORD=replace-with-airflow-password
AIRFLOW_SECRET_KEY=replace-with-stable-generated-secret
# Set a stable URL-safe base64 key generated from 32 random bytes.
AIRFLOW_FERNET_KEY=
# Local validation ports; public deployments set the actual remote HTTPS API URL.
NATIVE_API_HOST=127.0.0.1
NATIVE_API_PORT=8097
NATIVE_WEB_HOST=127.0.0.1
NATIVE_WEB_PORT=8098
NATIVE_AIRFLOW_PORT=8099
INGESTION_API_URL=http://localhost:8097
MAX_UPLOAD_BYTES=10737418240
